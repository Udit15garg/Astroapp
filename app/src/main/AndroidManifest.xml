<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Astroapp">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Palm reading flow -->
        <activity android:name=".ScanActivity" android:exported="false" />
        <activity android:name=".ResultActivity" android:exported="false" />

        <!-- Auth -->
        <activity android:name=".AuthActivity" android:exported="false" />

        <!-- Main dashboard -->
        <activity android:name=".HomeActivity" android:exported="false" />

        <!-- Multi-feature (Tarot / Numerology / Kundli / Sign / SunSign) -->
        <activity android:name=".FeatureActivity" android:exported="false" />

        <!-- Plans and credits -->
        <activity android:name=".SubscriptionActivity" android:exported="false" />

        <!-- Q&A history -->
        <activity android:name=".HistoryActivity" android:exported="false" />

        <!-- User profile + coins history -->
        <activity android:name=".ProfileActivity" android:exported="false" />

    </application>
</manifest>
