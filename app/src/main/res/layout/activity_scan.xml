<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_topbar_icon"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back_arrow"
            app:tint="@color/brand_gold"
            android:contentDescription="@string/cd_back_button" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_header_subtitle_v2"
                android:textSize="12sp"
                android:textColor="@color/text_medium" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_intro_v2"
                android:textSize="13sp"
                android:textColor="@color/text_medium"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_score_track"
                android:padding="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_handedness_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgHandedness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <RadioButton
                    android:id="@+id/rbRightHanded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/scan_handedness_right" />

                <RadioButton
                    android:id="@+id/rbLeftHanded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_handedness_left" />

                <RadioButton
                    android:id="@+id/rbNotSure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_handedness_not_sure" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_instruction_v2"
                    android:textSize="13sp"
                    android:textColor="@color/text_medium" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_passive_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_passive_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <ImageView
                        android:id="@+id/ivPassivePreview"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_preview"
                        android:contentDescription="@string/scan_slot_passive_title" />

                    <TextView
                        android:id="@+id/tvPassiveGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_pending"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPassiveCapture"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/scan_capture_passive"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_active_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_active_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <ImageView
                        android:id="@+id/ivActivePreview"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_preview"
                        android:contentDescription="@string/scan_slot_active_title" />

                    <TextView
                        android:id="@+id/tvActiveGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_pending"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActiveCapture"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/scan_capture_active"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_detail_a_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_detail_a_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <ImageView
                        android:id="@+id/ivDetailAPreview"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_preview"
                        android:contentDescription="@string/scan_slot_detail_a_title" />

                    <TextView
                        android:id="@+id/tvDetailAGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_optional"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailACapture"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/scan_capture_detail_a"
                        android:backgroundTint="@color/secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_detail_b_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_detail_b_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <ImageView
                        android:id="@+id/ivDetailBPreview"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_preview"
                        android:contentDescription="@string/scan_slot_detail_b_title" />

                    <TextView
                        android:id="@+id/tvDetailBGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_optional"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailBCapture"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/scan_capture_detail_b"
                        android:backgroundTint="@color/secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_analyze_v2"
                android:textSize="15sp"
                android:backgroundTint="@color/primary" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
