<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_topbar_icon"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back_arrow"
            app:tint="@color/brand_gold"
            android:contentDescription="@string/cd_back_button" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_header_subtitle_v2"
                android:textSize="12sp"
                android:textColor="@color/text_medium" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_intro_v2"
                android:textSize="13sp"
                android:textColor="@color/text_medium"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_score_track"
                android:padding="14dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_instruction_v2"
                android:textSize="13sp"
                android:textColor="@color/text_medium"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_score_track"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_loader_title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/glass_card_border" />

                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_loading_lines"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvProgressSubtext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_progress_subtext"
                    android:textSize="12sp"
                    android:textColor="@color/text_medium"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivPassivePreview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_feature_palmistry"
                            android:tint="@color/brand_gold"
                            android:contentDescription="@string/scan_slot_passive_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_passive_title"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_passive_subtitle"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp">

                            <ProgressBar
                                android:id="@+id/progressPassiveState"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:indeterminateTint="@color/primary" />

                            <TextView
                                android:id="@+id/tvPassiveStateIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="o"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_medium" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPassiveGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_pending"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPassiveCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="end"
                        android:text="@string/scan_button_upload"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivActivePreview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_feature_palmistry"
                            android:tint="@color/brand_gold"
                            android:contentDescription="@string/scan_slot_active_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_active_title"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_active_subtitle"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp">

                            <ProgressBar
                                android:id="@+id/progressActiveState"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:indeterminateTint="@color/primary" />

                            <TextView
                                android:id="@+id/tvActiveStateIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="o"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_medium" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_pending"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActiveCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="end"
                        android:text="@string/scan_button_upload"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivDetailAPreview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_feature_palmistry"
                            android:tint="@color/brand_gold"
                            android:contentDescription="@string/scan_slot_detail_a_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_detail_a_title"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_detail_a_subtitle"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp">

                            <ProgressBar
                                android:id="@+id/progressDetailAState"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:indeterminateTint="@color/primary" />

                            <TextView
                                android:id="@+id/tvDetailAStateIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="o"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_medium" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailAGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_optional"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailACapture"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="end"
                        android:text="@string/scan_button_upload"
                        android:backgroundTint="@color/secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/glass_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivDetailBPreview"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_feature_palmistry"
                            android:tint="@color/brand_gold"
                            android:contentDescription="@string/scan_slot_detail_b_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_detail_b_title"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scan_slot_detail_b_subtitle"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp">

                            <ProgressBar
                                android:id="@+id/progressDetailBState"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:indeterminateTint="@color/primary" />

                            <TextView
                                android:id="@+id/tvDetailBStateIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="o"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_medium" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailBGuidance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_slot_optional"
                        android:textSize="12sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginTop="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailBCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="end"
                        android:text="@string/scan_button_upload"
                        android:backgroundTint="@color/secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAnalyzeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_continue_hint"
                android:textSize="12sp"
                android:textColor="@color/text_medium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_analyze_v2"
                android:textSize="15sp"
                android:backgroundTint="@color/primary" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
