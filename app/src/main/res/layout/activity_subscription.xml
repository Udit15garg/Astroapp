<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_warm">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_topbar_icon"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back_arrow"
            android:tint="@color/brand_gold"
            android:contentDescription="@string/cd_back_button" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <TextView
                android:id="@+id/tvCurrentCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credits_single"
                android:textSize="12sp"
                android:textColor="@color/text_medium" />
        </LinearLayout>

        <!-- Credits pill -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/banner_gold_bg"
            app:strokeColor="@color/brand_gold"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_coin"
                    android:tint="@color/brand_gold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/credits_single"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_gold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Page headline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_choose_plan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlock deeper cosmic insights"
                android:textSize="13sp"
                android:textColor="@color/text_medium"
                android:layout_marginBottom="16dp" />

            <!-- Coin history link -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCoinHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/sub_coin_history"
                android:textColor="@color/text_medium"
                app:icon="@drawable/ic_coin"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/brand_gold"
                app:strokeColor="@color/outline"
                app:cornerRadius="14dp" />

            <!-- ── Plan 1: Starter Pack ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/plan_basic"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title row + price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sub_starter_title"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sub_starter_desc"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#8377;49"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/secondary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="one-time"
                                android:textSize="11sp"
                                android:textColor="@color/text_medium"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Feature bullets -->
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="·  5 AI-powered readings"
                        android:textSize="13sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="·  All 6 features included"
                        android:textSize="13sp"
                        android:textColor="@color/text_medium"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="·  1 follow-up question per reading"
                        android:textSize="13sp"
                        android:textColor="@color/text_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy49"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sub_starter_buy"
                        android:textStyle="bold"
                        android:backgroundTint="@color/secondary"
                        android:textColor="@color/on_secondary"
                        android:layout_marginTop="14dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Plan 2: Monthly (MOST POPULAR) ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/plan_popular_bg"
                app:strokeColor="@color/banner_gold_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Most popular badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/banner_gold_bg"
                        app:strokeColor="@color/brand_gold"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✦  MOST POPULAR"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_gold"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Title row + price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sub_basic_title"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sub_basic_desc"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#8377;99"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/brand_gold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/ month"
                                android:textSize="11sp"
                                android:textColor="@color/text_medium"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Feature bullets -->
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Unlimited readings for 30 days"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  All 6 mystical features"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Unlimited follow-up Q&amp;A"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy99"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sub_basic_buy"
                        android:textStyle="bold"
                        android:backgroundTint="@color/brand_gold"
                        android:textColor="@color/on_secondary"
                        android:layout_marginTop="14dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Plan 3: Pro Monthly ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/plan_unlimited"
                app:strokeColor="@color/card_numerology_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title row + price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sub_unlimited_title"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sub_unlimited_desc"
                                android:textSize="12sp"
                                android:textColor="@color/text_medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#8377;199"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/success" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/ month"
                                android:textSize="11sp"
                                android:textColor="@color/text_medium"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Feature bullets -->
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Everything in Monthly"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Priority AI responses"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Downloadable reading summary"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy199"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sub_unlimited_buy"
                        android:textStyle="bold"
                        android:backgroundTint="@color/success"
                        android:textColor="@color/on_primary"
                        android:layout_marginTop="14dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="16dp" />

            <!-- Free trial -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFreeTrial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_free_trial"
                android:textColor="@color/text_medium"
                android:backgroundTint="@color/bg_warm"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/outline"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
